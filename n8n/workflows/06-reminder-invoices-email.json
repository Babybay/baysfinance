{
  "name": "BaysConsult — Invoice Overdue Email Reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "triggerAtHour": 9 }]
        }
      },
      "id": "schedule-6",
      "name": "Every Day 09:00 WIB",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:3000/api/cron/reminder-invoices",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "http-6",
      "name": "Get Overdue Invoices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "CRON_SECRET_CREDENTIAL_ID", "name": "BaysConsult Cron Secret" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-6a",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt", "name": "filter.operator.gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-6",
      "name": "Any Reminders?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "reminders",
        "options": {}
      },
      "id": "split-6",
      "name": "Split Reminders",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [900, 240]
    },
    {
      "parameters": {
        "fromEmail": "noreply@baysconsult.com",
        "toEmail": "={{ $json.clientEmail }}",
        "subject": "=💳 Reminder Pembayaran Invoice {{ $json.nomorInvoice }}",
        "emailType": "html",
        "html": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <div style=\"background: #dc2626; color: white; padding: 20px; border-radius: 8px 8px 0 0;\">\n    <h2 style=\"margin: 0;\">💳 Reminder Pembayaran Invoice</h2>\n  </div>\n  <div style=\"padding: 20px; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 8px 8px;\">\n    <p>Yth. <strong>{{ $json.clientName }}</strong>,</p>\n    <p>Invoice berikut telah melewati jatuh tempo dan belum kami terima pembayarannya:</p>\n    <table style=\"width: 100%; border-collapse: collapse; margin: 16px 0;\">\n      <tr><td style=\"padding: 8px; border-bottom: 1px solid #e5e7eb; color: #6b7280;\">No. Invoice</td><td style=\"padding: 8px; border-bottom: 1px solid #e5e7eb; font-weight: bold;\">{{ $json.nomorInvoice }}</td></tr>\n      <tr><td style=\"padding: 8px; border-bottom: 1px solid #e5e7eb; color: #6b7280;\">Total</td><td style=\"padding: 8px; border-bottom: 1px solid #e5e7eb; font-weight: bold; color: #dc2626;\">Rp {{ $json.total }}</td></tr>\n      <tr><td style=\"padding: 8px; border-bottom: 1px solid #e5e7eb; color: #6b7280;\">Jatuh Tempo</td><td style=\"padding: 8px; border-bottom: 1px solid #e5e7eb;\">{{ $json.jatuhTempo }}</td></tr>\n      <tr><td style=\"padding: 8px; color: #6b7280;\">Terlambat</td><td style=\"padding: 8px; color: #dc2626; font-weight: bold;\">{{ $json.daysOverdue }} hari</td></tr>\n    </table>\n    {{ $json.namaBank ? '<div style=\"background: #f3f4f6; padding: 16px; border-radius: 8px; margin: 16px 0;\"><p style=\"margin: 0 0 8px; font-weight: bold;\">Info Pembayaran:</p><p style=\"margin: 0;\">Bank: ' + $json.namaBank + '<br>No. Rekening: ' + $json.nomorRekening + '<br>Atas Nama: ' + $json.atasNama + '</p></div>' : '' }}\n    <p>Mohon segera lakukan pembayaran. Jika sudah membayar, harap abaikan email ini.</p>\n    <p style=\"color: #6b7280; font-size: 12px; margin-top: 24px;\">— Tim BaysConsult</p>\n  </div>\n</div>",
        "options": {}
      },
      "id": "email-6",
      "name": "Send Invoice Reminder Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1120, 240],
      "credentials": {
        "smtp": { "id": "SMTP_CREDENTIAL_ID", "name": "BaysConsult SMTP" }
      }
    }
  ],
  "connections": {
    "Every Day 09:00 WIB": { "main": [[{ "node": "Get Overdue Invoices", "type": "main", "index": 0 }]] },
    "Get Overdue Invoices": { "main": [[{ "node": "Any Reminders?", "type": "main", "index": 0 }]] },
    "Any Reminders?": { "main": [[{ "node": "Split Reminders", "type": "main", "index": 0 }], []] },
    "Split Reminders": { "main": [[{ "node": "Send Invoice Reminder Email", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Asia/Jakarta" },
  "tags": [{ "name": "BaysConsult" }, { "name": "Notifications" }]
}
