{
  "name": "BaysConsult — Permit Status Change Notifications",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "triggerAtHour": 8 },
            { "triggerAtHour": 14 },
            { "triggerAtHour": 20 }
          ]
        }
      },
      "id": "schedule-7",
      "name": "3x Daily (08, 14, 20 WIB)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:3000/api/cron/permit-updates",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "http-7",
      "name": "Get Permit Updates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "CRON_SECRET_CREDENTIAL_ID", "name": "BaysConsult Cron Secret" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-7a",
              "leftValue": "={{ $json.count }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt", "name": "filter.operator.gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-7",
      "name": "Any Updates?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "updates",
        "options": {}
      },
      "id": "split-7",
      "name": "Split Updates",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [900, 240]
    },
    {
      "parameters": {
        "fromEmail": "noreply@baysconsult.com",
        "toEmail": "={{ $json.clientEmail }}",
        "subject": "=📋 Update Status Perizinan {{ $json.caseId }}",
        "emailType": "html",
        "html": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <div style=\"background: #059669; color: white; padding: 20px; border-radius: 8px 8px 0 0;\">\n    <h2 style=\"margin: 0;\">📋 Update Status Perizinan</h2>\n  </div>\n  <div style=\"padding: 20px; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 8px 8px;\">\n    <p>Yth. <strong>{{ $json.clientName }}</strong>,</p>\n    <p>Status perizinan Anda telah diperbarui:</p>\n    <table style=\"width: 100%; border-collapse: collapse; margin: 16px 0;\">\n      <tr><td style=\"padding: 8px; border-bottom: 1px solid #e5e7eb; color: #6b7280;\">No. Kasus</td><td style=\"padding: 8px; border-bottom: 1px solid #e5e7eb; font-weight: bold;\">{{ $json.caseId }}</td></tr>\n      <tr><td style=\"padding: 8px; border-bottom: 1px solid #e5e7eb; color: #6b7280;\">Jenis Izin</td><td style=\"padding: 8px; border-bottom: 1px solid #e5e7eb;\">{{ $json.permitType }}</td></tr>\n      <tr><td style=\"padding: 8px; border-bottom: 1px solid #e5e7eb; color: #6b7280;\">Status Sebelumnya</td><td style=\"padding: 8px; border-bottom: 1px solid #e5e7eb;\">{{ $json.previousStatus || '-' }}</td></tr>\n      <tr><td style=\"padding: 8px; border-bottom: 1px solid #e5e7eb; color: #6b7280;\">Status Baru</td><td style=\"padding: 8px; border-bottom: 1px solid #e5e7eb; font-weight: bold; color: #059669;\">{{ $json.newStatus }}</td></tr>\n      <tr><td style=\"padding: 8px; color: #6b7280;\">Keterangan</td><td style=\"padding: 8px;\">{{ $json.description }}</td></tr>\n    </table>\n    <p>Silakan login ke dashboard untuk melihat detail lebih lanjut.</p>\n    <p style=\"color: #6b7280; font-size: 12px; margin-top: 24px;\">— Tim BaysConsult</p>\n  </div>\n</div>",
        "options": {}
      },
      "id": "email-7",
      "name": "Send Permit Update Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1120, 240],
      "credentials": {
        "smtp": { "id": "SMTP_CREDENTIAL_ID", "name": "BaysConsult SMTP" }
      }
    }
  ],
  "connections": {
    "3x Daily (08, 14, 20 WIB)": { "main": [[{ "node": "Get Permit Updates", "type": "main", "index": 0 }]] },
    "Get Permit Updates": { "main": [[{ "node": "Any Updates?", "type": "main", "index": 0 }]] },
    "Any Updates?": { "main": [[{ "node": "Split Updates", "type": "main", "index": 0 }], []] },
    "Split Updates": { "main": [[{ "node": "Send Permit Update Email", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Asia/Jakarta" },
  "tags": [{ "name": "BaysConsult" }, { "name": "Notifications" }]
}
