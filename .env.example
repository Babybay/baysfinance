# Auth
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Primary database: Neon Postgres
# Use the pooled Neon URL for the running Next.js app. Neon pooled hosts include "-pooler".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional direct Neon URL for migration/admin tools that need an unpooled connection.
# Keep this out of client code.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Object storage: Cloudflare R2 / S3-compatible storage
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=baysconsult-docs
R2_REGION=auto
R2_PUBLIC_URL=

# TrueNAS MinIO can use the same code path if needed later.
# MINIO_ENDPOINT=https://s3.yourdomain.com
# MINIO_ACCESS_KEY_ID=
# MINIO_SECRET_ACCESS_KEY=
# MINIO_BUCKET_NAME=baysconsult-docs
# MINIO_PUBLIC_URL=https://s3.yourdomain.com/baysconsult-docs
# MINIO_HOSTNAME=s3.yourdomain.com
# MINIO_REGION=us-east-1

# Cron Secret
CRON_SECRET=

# Optional OCR service
OCR_SERVICE_URL=http://localhost:8100
